        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n  T[\&quot;ERD QUẢN LÝ ĐĂNG KÝ KHÓA HỌC EDUSMART\&quot;]\n\n  subgraph ERD[\&quot;MÔ HÌNH ERD\&quot;]\n    HV[\&quot;HOC_VIEN&lt;br/&gt;────────────&lt;br/&gt;🔑 MaHV (PK)&lt;br/&gt;HoTen&lt;br/&gt;NgaySinh\&quot;]\n    DK[\&quot;DANG_KY&lt;br/&gt;────────────&lt;br/&gt;🔑 MaHV (PK, FK)&lt;br/&gt;🔑 MaKH (PK, FK)&lt;br/&gt;DiemSo\&quot;]\n    KH[\&quot;KHOA_HOC&lt;br/&gt;────────────&lt;br/&gt;🔑 MaKH (PK)&lt;br/&gt;TenKH&lt;br/&gt;SoTietHoc\&quot;]\n\n    HV ||--o{ DK\n    KH ||--o{ DK\n  end\n\n  N[\&quot;Quan hệ N-N được chuyển thành&lt;br/&gt;hai quan hệ 1-N qua thực thể trung gian DANG_KY\&quot;]\n\n  subgraph NF[\&quot;RÀ SOÁT CHUẨN HÓA 2NF\&quot;]\n    DRAFT[\&quot;BẢNG NHÁP&lt;br/&gt;&lt;br/&gt;(MaHV, MaKH) là khóa chính ghép&lt;br/&gt;TenKH chỉ phụ thuộc vào MaKH&lt;br/&gt;→ Vi phạm 2NF: phụ thuộc bộ phận&lt;br/&gt;DiemSo phụ thuộc đầy đủ vào (MaHV, MaKH)\&quot;]\n    KH2[\&quot;KHOA_HOC&lt;br/&gt;────────────&lt;br/&gt;🔑 MaKH (PK)&lt;br/&gt;TenKH&lt;br/&gt;SoTietHoc\&quot;]\n    DK2[\&quot;DANG_KY&lt;br/&gt;────────────&lt;br/&gt;🔑 MaHV (PK, FK)&lt;br/&gt;🔑 MaKH (PK, FK)&lt;br/&gt;DiemSo\&quot;]\n    DRAFT -.-&gt;|\&quot;Tách TenKH và SoTietHoc sang KHOA_HOC\&quot;| KH2\n    DRAFT -.-&gt;|\&quot;Giữ thuộc tính phụ thuộc đầy đủ vào khóa ghép\&quot;| DK2\n  end\n\n  R[\&quot;Kết quả đạt 2NF:&lt;br/&gt;mỗi thuộc tính không khóa phụ thuộc đầy đủ&lt;br/&gt;vào toàn bộ khóa chính của bảng.\&quot;]\n\n  T --&gt; ERD\n  ERD --&gt; N\n  N --&gt; NF\n  NF --&gt; R\n\n\n  class T title\n  class HV student\n  class DK,DK2 enrollment\n  class KH,KH2 course\n  class N note\n  class DRAFT warning\n  class R result\n\n  style ERD fill:#f8fbff,stroke:#9dc3e6,stroke-width:2px\n  style NF fill:#fffdf5,stroke:#d6b656,stroke-width:2px\n  linkStyle 0,1 stroke:#4f81bd,stroke-width:2px&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="19">
